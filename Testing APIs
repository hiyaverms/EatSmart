from backend.services.spoonacular_api import get_recipes_by_ingredients
from backend.services.llm_wrapper import llm_filter_recipes
import json

ingredients = ["pasta", "beef", "sesame", "jackfruit", "tomato sauce", "plantain", "basil", "cheese", "coconut", "red curry paste"]
recipes = get_recipes_by_ingredients(
    ingredients,
    target_number=25,
    fetch_extra=5,
    max_missing=10
)

filtered_recipes = llm_filter_recipes(
    recipes,
    user_preferences=["high-protein", "vegetarian"],
    allergies=["peanuts", "shellfish", "gluten"],
    max_recipes=6
)

print(json.dumps(filtered_recipes, indent=2))
